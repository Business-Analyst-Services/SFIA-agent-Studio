# Required
ANTHROPIC_API_KEY=
PIP_MODEL=claude-opus-5-5
PIP_AGENT_MODEL=claude-sonnet-5-5

# Default SFIA level of responsibility for agents (1-7). Sets how autonomously they act. See config/autonomy.json.
PIP_DEFAULT_LEVEL=4

# Web widget + approvals API
PORT=3000
PIP_PUBLIC_URL=http://localhost:3000
# Shared secret the web widget sends as a bearer token. Leave empty only for local testing.
PIP_WEB_TOKEN=

# Slack (Socket Mode). Leave blank to disable.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Microsoft Teams (Azure Bot). Leave blank to disable.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
MICROSOFT_APP_TYPE=SingleTenant

# Gmail (OAuth client for the mailbox Pip watches). Leave blank to disable.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_WATCH_LABEL=Ask-Pip
GMAIL_POLL_SECONDS=60
# draft = Pip writes reply drafts for a human to send; send = Pip sends replies itself
GMAIL_REPLY_MODE=draft

# Tokens for the MCP servers in config/mcp-servers.json (referenced as ${VAR})
GITHUB_TOKEN=
ATLASSIAN_TOKEN=
SENTRY_TOKEN=
NOTION_TOKEN=
LINEAR_TOKEN=
