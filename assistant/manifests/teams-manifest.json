{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.0",
  "id": "{{MICROSOFT_APP_ID}}",
  "developer": {
    "name": "Business Analyst Services",
    "websiteUrl": "https://business-analyst.services",
    "privacyUrl": "https://business-analyst.services/privacy",
    "termsOfUseUrl": "https://business-analyst.services/terms"
  },
  "name": { "short": "Pip", "full": "Pip IT Helper" },
  "description": {
    "short": "Your IT helper, backed by SFIA role agents.",
    "full": "Pip routes IT requests to 75 SFIA 9 role agents (service desk, architecture, security, data and more). Agents ask for approval before making changes."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#0F6E64",
  "bots": [
    { "botId": "{{MICROSOFT_APP_ID}}", "scopes": ["personal", "team", "groupChat"], "supportsFiles": false, "isNotificationOnly": false }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
