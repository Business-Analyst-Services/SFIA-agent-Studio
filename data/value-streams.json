     "handoff": "Requirements agreed with the legal team"
    },
    {
     "agent": "solution-architecture",
     "capability": "Solution ideation, analysis and design",
     "task": "Design the solution",
     "actions": [
      {
       "tool": "confluence.create_page",
       "risk": "write",
       "summary": "Publish the solution design",
       "result": "Solution design published",
       "artefact": {
        "kind": "Page",
        "system": "Confluence",
        "id": "ARCH-412",
        "title": "Solution design: Matter intake",
        "fields": {
         "Space": "Architecture",
         "Status": "Approved at forum",
         "Pattern": "Dynamics model-driven app"
        },
        "sections": [
         {
          "h": "Components",
          "items": [
           "Dynamics intake app with matter, party and conflict tables",
           "Conflict check via the practice management system API",
           "Power Automate approvals for partners",
           "SharePoint document library per matter"
          ]
         },
         {
          "h": "Decisions",
          "items": [
           "Reuse the existing Dynamics environment (no new platform)",
           "Single sign-on through the existing identity provider"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "Design approved at the architecture forum"
    },
    {
     "agent": "software-engineering",
     "capability": "Solution configuration, enhancement and development",
     "task": "Build and configure",
     "actions": [
      {
       "tool": "github.create_pull_request",
       "risk": "write",
       "summary": "Configure intake forms and workflow",
       "result": "PR #212 opened",
       "artefact": {
        "kind": "Pull request",
        "system": "GitHub",
        "id": "PR #212",
        "title": "Configure matter intake forms and approval flow",
        "fields": {
         "Branch": "feature/legal-intake \u2192 main",
         "Files changed": "14",
         "Checks": "All passing",
         "Reviewers": "2 approvals"
        },
        "sections": [
         {
          "h": "Changes",
          "items": [
           "Add Matter, Party and Conflict check tables",
           "Intake form with required fields and validation",
           "Partner approval flow",
           "Unit tests for conflict-check rules"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "Build complete, ready for test"
    },
    {
     "agent": "testing",
     "capability": "Solution testing and deployment",
     "task": "Test, including accessibility",
     "actions": [
      {
       "tool": "playwright.run_tests",
       "risk": "read",
       "summary": "Run UAT and accessibility checks",
       "result": "48 of 48 pass; 2 accessibility warnings fixed"
      }
     ],
     "handoff": "Signed off by the legal team"
    },
    {
     "agent": "service-introduction",
     "capability": "Service transition",
     "task": "Take it live",
     "actions": [
      {
       "tool": "servicenow.create_change",
       "risk": "write",
       "summary": "Raise a normal change for go-live",
       "result": "CHG0034 approved for Tuesday",
       "artefact": {
        "kind": "Change request",
        "system": "ServiceNow",
        "id": "CHG0034",
        "title": "Go-live: Matter intake",
        "fields": {
         "Type": "Normal",
         "Risk": "Low",
         "Window": "Tuesday 6:30\u20137:30am",
         "Approval": "CAB approved",
         "Backout": "Disable app; revert solution package"
        },
        "sections": [
         {
          "h": "Implementation plan",
