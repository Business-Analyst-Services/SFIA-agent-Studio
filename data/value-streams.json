  },
  {
   "id": "data-to-insight",
   "name": "Data to insight",
   "why": "Governed data becomes decisions and performance reporting.",
   "trigger": {
    "user": "Chief Data Officer",
    "msg": "I need a trustworthy IT performance report for the board next week"
   },
   "steps": [
    {
     "agent": "chief-data-officer",
