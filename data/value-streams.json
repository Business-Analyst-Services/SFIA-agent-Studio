      {
       "tool": "confluence.search",
       "risk": "read",
       "summary": "Find related demand and past requests",
       "result": "Similar request from Finance in 2025, nothing built"
      }
     ],
     "handoff": "Need confirmed, sponsor is the General Counsel"
    },
    {
     "agent": "agile-change-agents",
     "capability": "Demand and initiative intake",
     "task": "Log it as an initiative",
     "actions": [
      {
       "tool": "jira.create_issue",
       "risk": "write",
       "summary": "Log the initiative on the digital intake board",
       "result": "INIT-88 created",
       "artefact": {
        "kind": "Initiative",
        "system": "Jira",
        "id": "INIT-88",
        "title": "Matter intake system for the legal team",
        "fields": {
         "Board": "Digital intake",
         "Requester": "Tom Becker",
         "Sponsor": "General Counsel",
         "Status": "Assess",
         "Priority": "Medium"
        },
        "sections": [
         {
          "h": "Problem",
          "text": "Matter intake runs on email and a shared spreadsheet. Requests get lost, and conflict checks happen late."
         },
         {
          "h": "Desired outcome",
          "items": [
           "One intake form for all new matters",
           "Automatic conflict check before acceptance",
           "Visibility of matter status for the legal team"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "INIT-88 ready for assessment"
    },
    {
     "agent": "enterprise-architecture",
     "capability": "Enterprise architecture",
     "task": "Check fit with the roadmap and standards",
