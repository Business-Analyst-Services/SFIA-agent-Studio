  {
   "id": "incident-to-resolution",
   "name": "Incident to resolution",
   "why": "An outage is restored and the knowledge is kept.",
   "trigger": {
    "user": "Priya Nair",
    "msg": "The staff portal has been down since 7am, nobody can log in"
   },
   "steps": [
    {
     "agent": "service-desk",
     "capability": "Service desk",
     "task": "Log and triage",
     "actions": [
      {
       "tool": "servicenow.create_incident",
       "risk": "write",
       "summary": "Log a P2: portal sign-in failure",
       "result": "INC0012931 logged as P2",
       "artefact": {
        "kind": "Incident",
        "system": "ServiceNow",
        "id": "INC0012931",
        "title": "Staff portal: users cannot sign in",
        "fields": {
         "Priority": "P2",
         "Impact": "340 users",
         "Opened": "07:14",
         "Assignment group": "Service operations",
         "Caller": "Priya Nair"
        },
        "sections": [
         {
          "h": "Description",
          "text": "Since about 7am, staff get an error after entering their password on the staff portal."
         }
        ]
       }
      }
     ],
     "handoff": "P2 logged, 340 users affected"
    },
    {
     "agent": "service-operations",
     "capability": "Incident and problem management",
     "task": "Diagnose",
     "actions": [
      {
       "tool": "datadog.query_logs",
       "risk": "read",
       "summary": "Pull auth service errors since 7am",
       "result": "412 certificate errors, first at 07:02"
      },
      {
       "tool": "servicenow.create_problem",
       "risk": "write",
       "summary": "Open a problem record",
       "result": "PRB0004410 opened",
       "artefact": {
        "kind": "Problem",
        "system": "ServiceNow",
        "id": "PRB0004410",
        "title": "Expired TLS certificate on the sign-in service",
        "fields": {
         "Linked incident": "INC0012931",
         "State": "Root cause known",
         "Assigned to": "Platform team"
        },
        "sections": [
         {
          "h": "Root cause",
          "text": "The sign-in service certificate expired at 07:02. Renewal was manual and missed."
         },
         {
          "h": "Fix",
          "items": [
           "Restart with the renewed certificate",
           "Automate expiry alerts for all certificates"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "Expired certificate on the sign-in service"
    },
    {
     "agent": "application-support",
     "capability": "Application support",
     "task": "Rule out the application",
     "actions": [
      {
       "tool": "sentry.list_issues",
       "risk": "read",
       "summary": "Check for application errors and regressions",
       "result": "No regressions; failures happen at the sign-in handshake"
      }
     ],
     "handoff": "App is fine; fix belongs to the platform"
    },
    {
     "agent": "infrastructure-operations",
     "capability": "System administration",
     "task": "Fix the platform",
     "actions": [
      {
       "tool": "kubernetes.rollout_restart",
       "risk": "destructive",
       "summary": "Restart the sign-in service with the renewed certificate",
       "result": "Sign-ins restored at 09:41",
       "artefact": {
        "kind": "Platform action",
        "system": "Kubernetes",
        "id": "auth-svc",
        "title": "Rolling restart with renewed certificate",
        "fields": {
         "Cluster": "prod-syd-1",
         "Started": "09:36",
         "Finished": "09:41",
         "Result": "Success"
        },
        "sections": [
         {
          "h": "Log",
          "items": [
           "09:36 Secret auth-tls updated",
           "09:37 Rollout started (3 pods)",
           "09:40 3/3 pods healthy",
           "09:41 Sign-in success rate 99.8%"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "Service restored"
    },
    {
     "agent": "site-reliability-engineer-sre",
     "capability": "Capacity and availability management",
     "task": "Stop it happening again",
     "actions": [
      {
       "tool": "grafana.create_alert",
       "risk": "write",
       "summary": "Alert 14 days before any certificate expires",
       "result": "Alert rule created for 23 certificates",
       "artefact": {
        "kind": "Alert rule",
        "system": "Grafana",
        "id": "ALERT-cert-expiry",
        "title": "Certificate expires in 14 days",
        "fields": {
         "Covers": "23 certificates",
         "Condition": "days_to_expiry < 14",
         "Notify": "Platform team channel and on-call",
         "Repeat": "Daily until renewed"
        },
        "sections": [
         {
          "h": "Rule",
          "items": [
           "Query: days_to_expiry per certificate, evaluated hourly",
           "Fires at 14 days, repeats daily until renewed",
           "Routes to the Platform team channel and on-call"
          ]
         },
         {
          "h": "Coverage",
          "text": "All 23 certificates discovered across prod-syd-1 and prod-syd-2, including the sign-in service certificate that caused INC0012931."
         }
        ]
       }
      }
     ],
     "handoff": "Early warning in place"
    },
    {
     "agent": "technical-writing",
     "capability": "Knowledge management",
     "task": "Keep the knowledge",
     "actions": [
      {
       "tool": "confluence.create_page",
       "risk": "write",
       "summary": "Publish a knowledge article",
       "result": "Knowledge article published",
       "artefact": {
        "kind": "Knowledge article",
        "system": "Confluence",
        "id": "KB-1043",
        "title": "Staff portal sign-in fails after entering password",
        "fields": {
         "Space": "IT knowledge base",
         "Audience": "Service desk",
         "Linked": "INC0012931, PRB0004410"
        },
        "sections": [
         {
          "h": "Symptoms",
          "text": "Users see an error immediately after entering their password."
         },
         {
          "h": "Check",
          "items": [
           "Look for certificate errors in the auth service logs",
           "Check the certificate expiry dashboard"
          ]
         },
         {
          "h": "Resolve",
          "text": "Escalate to the Platform team to renew the certificate and restart the service."
         }
        ]
       }
      }
     ],
     "handoff": "Knowledge article live"
    }
   ],
   "outcome": "The portal is back up (down 2h39m). The cause was an expired certificate, an alert now covers all 23 certificates, and the knowledge article is published."
  },
  {
   "id": "cyber-event-to-recovery",
   "name": "Cyber event to recovery",
   "why": "A security alert is contained and lessons are applied.",
   "trigger": {
    "user": "SOC alert",
    "msg": "Impossible-travel sign-ins detected on 3 staff accounts"
   },
   "steps": [
    {
     "agent": "security-operations",
     "capability": "Security monitoring and detection",
     "task": "Detect and confirm",
     "actions": [
      {
       "tool": "splunk.search_events",
       "risk": "read",
       "summary": "Correlate sign-ins across locations",
       "result": "3 accounts signed in from Sydney and Lagos within 20 minutes"
      }
     ],
     "handoff": "Confirmed account compromise, 3 users"
    },
    {
     "agent": "incident-management",
     "capability": "Security incident response",
     "task": "Contain",
     "actions": [
      {
       "tool": "entra.revoke_sessions",
       "risk": "destructive",
       "summary": "Revoke sessions and force a password reset for the 3 accounts",
       "result": "Sessions revoked, resets forced",
       "artefact": {
        "kind": "Containment action",
        "system": "Identity provider",
        "id": "SEC-ACT-77",
        "title": "Revoke sessions and force reset for 3 accounts",
        "fields": {
         "Accounts": "3",
         "Executed": "10:12",
         "Approved by": "You"
        },
        "sections": [
         {
          "h": "Actions",
          "items": [
           "All active sessions revoked",
           "Password reset required at next sign-in",
           "MFA re-registration required",
           "Sign-ins from Lagos blocked by conditional access"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "Contained at 10:12"
    },
    {
     "agent": "infrastructure-operations",
     "capability": "Backup and recovery",
     "task": "Check for damage",
     "actions": [
      {
       "tool": "aws.list_backup_plans",
       "risk": "read",
       "summary": "Confirm clean restore points for affected mailboxes",
       "result": "Clean restore points from 06:00 available"
      }
     ],
     "handoff": "No data loss; restore points confirmed"
    },
    {
     "agent": "security-risk-management-audit-and-compliance",
     "capability": "Risk management",
     "task": "Review and record",
     "actions": [
      {
       "tool": "jira.create_issue",
       "risk": "write",
       "summary": "Open the post-incident review and update the risk register",
       "result": "SEC-301 opened; risk register updated",
       "artefact": {
        "kind": "Post-incident review",
        "system": "Jira",
        "id": "SEC-301",
        "title": "Post-incident review: account compromise via phishing",
        "fields": {
         "Severity": "High",
         "Time to contain": "34 minutes",
         "Data loss": "None found",
         "Risk register": "R-17 updated"
        },
        "sections": [
         {
          "h": "What happened",
          "text": "A phishing email harvested credentials for 3 accounts. One account had no MFA."
         },
         {
          "h": "Actions",
          "items": [
           "Enforce MFA for all accounts (owner: Identity, due 2 weeks)",
           "Block the sender domain (done)",
           "Phishing awareness for affected teams (sent)"
          ]
         }
        ]
       }
      }
     ],
     "handoff": "Root cause: phishing email, no MFA on 1 account"
    },
    {
     "agent": "learning-development-l-d",
     "capability": "Security training and awareness",
     "task": "Apply the lessons",
     "actions": [
      {
       "tool": "m365.send_mail",
       "risk": "destructive",
       "summary": "Send a phishing awareness module to affected teams",
       "result": "Module sent to 4 teams (62 people)",
       "artefact": {
        "kind": "Email",
        "system": "Microsoft 365",
        "id": "MSG-5520",
        "title": "Spot the phish: 10-minute refresher",
        "fields": {
         "To": "4 teams (62 people)",
         "From": "IT Security",
         "Sent": "11:05"
        },
        "sections": [
         {
          "h": "Message",
          "text": "Last week a convincing phishing email reached some of our teams. This 10-minute module shows the signs to look for and how to report a suspicious email. Please complete it by Friday."
         }
        ]
       }
      }
     ],
     "handoff": "Awareness training under way"
    }
   ],
   "outcome": "Contained in 34 minutes with no data loss. The root cause was phishing plus one account without MFA. The review is logged and the affected teams have training."
  },
