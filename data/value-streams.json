        ]
       }
      }
     ],
     "handoff": "Business case: $38k, payback in 14 months"
    },
    {
     "agent": "project-delivery-practice-management",
     "capability": "Project portfolio management",
     "task": "Prioritise and fund",
     "actions": [
      {
       "tool": "jira.update_issue",
       "risk": "write",
       "summary": "Rank INIT-88 in the portfolio",
       "result": "Ranked #3 and funded for Q1",
       "artefact": {
        "kind": "Initiative update",
        "system": "Jira",
        "id": "INIT-88",
        "title": "Matter intake system for the legal team",
        "fields": {
         "Status": "Assess \u2192 Approved",
         "Portfolio rank": "3 of 27",
         "Funding": "Q1, $38,000",
         "Project manager": "Assigned"
        },
        "sections": [
         {
          "h": "Portfolio note",
          "text": "Ranked third: low cost, existing platform, clear risk reduction."
         }
        ]
       }
      }
     ],
     "handoff": "Funded for Q1, project manager assigned"
    },
    {
     "agent": "business-analysis",
     "capability": "Solution ideation, analysis and design",
     "task": "Run discovery and write requirements",
     "actions": [
      {
       "tool": "jira.create_epic",
       "risk": "write",
       "summary": "Create a discovery epic with 6 starter stories",
       "result": "LEGAL-14 created with 6 stories",
       "artefact": {
        "kind": "Epic",
        "system": "Jira",
        "id": "LEGAL-14",
        "title": "Discovery: matter intake",
        "fields": {
         "Project": "LEGAL",
         "Linked to": "INIT-88",
         "Stories": "6"
        },
        "sections": [
         {
          "h": "Stories",
          "items": [
           "LEGAL-15 As a lawyer, I can submit a new matter in one form",
           "LEGAL-16 As a paralegal, I can see conflict-check results before acceptance",
           "LEGAL-17 As a partner, I can approve or decline a matter",
           "LEGAL-18 As the legal team, we can see every matter's status",
           "LEGAL-19 As records, matters are filed with the right retention",
           "LEGAL-20 As an admin, I can report on intake volumes"
